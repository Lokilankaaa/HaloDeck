{
  "schemaVersion": 1,
  "id": "halodeck.backend-demo",
  "name": "硬件曲线与一键诊断报告",
  "version": "1.1.0",
  "author": "HaloDeck",
  "description": "实时绘制 APU 功耗与温度曲线，并通过独立 JSON-RPC 后端进程一键导出硬件/游戏库诊断报告（同时作为独立后端插件开发模板）。",
  "homepage": "https://github.com/Lokilankaaa/HaloDeck/tree/main/examples/plugins/halodeck.backend-demo",
  "minHaloDeckVersion": "0.6.0",
  "mount": ["console", "qam"],
  "activation": ["onView"],
  "entry": "ui/index.html",
  "backend": {
    "type": "stdio-jsonrpc",
    "executable": "backend/worker.ps1",
    "idleTimeoutSeconds": 180
  },
  "permissions": ["games:read", "telemetry:read", "shell:openFolder", "backend"]
}
