<Window x:Class="HandheldOpti.App.QamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HandheldOpti QAM"
        Width="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#0B101B">
    <Border BorderBrush="#26334E" BorderThickness="1,0,0,0" Background="#0B101B">
        <wv2:WebView2 x:Name="QamWebView" DefaultBackgroundColor="#0B101B" />
    </Border>
</Window>
